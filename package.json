{
  "name": "react-headroom",
  "description": "Hide your header until you need it. React.js port of headroom.js",
  "version": "3.2.1",
  "author": "Kyle Mathews <mathews.kyle@gmail.com>",
  "bugs": {
    "url": "https://github.com/KyleAMathews/react-headroom/issues"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.13",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@tanstack/eslint-plugin-oracles": "https://pkg.pr.new/TanStack/oracles/@tanstack/eslint-plugin-oracles@4749f61",
    "@tanstack/oracles": "https://pkg.pr.new/TanStack/oracles/@tanstack/oracles@4749f61",
    "acorn": "^8.19.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vitest": "^4.1.12"
  },
  "directories": {
    "example": "examples"
  },
  "homepage": "https://github.com/KyleAMathews/react-headroom",
  "keywords": [
    "headroom",
    "react",
    "react-component"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "sideEffects": false,
  "peerDependencies": {
    "react": "^16.9.0 || ^17 || ^18 || ^19"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KyleAMathews/react-headroom.git"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && babel --env-name cjs src --out-dir dist && babel src --out-dir dist/esm",
    "test": "pnpm unit-test && pnpm test:oracles && pnpm lint",
    "unit-test": "vitest run",
    "test:oracles": "vitest run --config vitest.oracle.config.mjs",
    "test:oracles:chrome": "ORACLE_BROWSER=chrome vitest run --config vitest.oracle.config.mjs test/headroom.oracle.js",
    "test:gaps": "oracle-gaps --package . --source src/index.js,src/Headroom.js,src/core.js,src/useHeadroom.js,src/shouldUpdate.js --config vitest.oracle.config.mjs --seed 1 --out .oracle-gaps/out",
    "test-watch": "vitest",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"test/**/*.js\"",
    "publish-patch": "pnpm build && npm version patch && npm publish; git push; git push --tags"
  },
  "packageManager": "pnpm@11.1.0",
  "files": [
    "dist"
  ]
}
